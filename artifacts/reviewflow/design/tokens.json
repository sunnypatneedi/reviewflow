{
  "$schema-note": "ReviewFlow v4 design tokens. Every colour derives from two values per theme (paper, ink) plus ONE semantic exception set (danger, warn). build_tokens.py turns this file into tokens.css and checks contrast.",
  "ramp": [
    6,
    12,
    20,
    40,
    64,
    85,
    100
  ],
  "themes": {
    "light": {
      "label": "Light",
      "paper": "#FFFFFF",
      "ink": "#191919",
      "muted": 76,
      "exception": {
        "danger": "#921318",
        "warn": "#6B3A00"
      }
    },
    "dark": {
      "label": "Dark",
      "paper": "#161616",
      "ink": "#EDEDEC",
      "muted": 72,
      "exception": {
        "danger": "#FF9C94",
        "warn": "#F0C36A"
      }
    },
    "plum": {
      "label": "Plum (tinted)",
      "paper": "#F7F4F9",
      "ink": "#2A1338",
      "muted": 80,
      "exception": {
        "danger": "#8A1029",
        "warn": "#623400"
      }
    }
  },
  "roles": {
    "text-primary": "ink.100",
    "text-secondary": "ink.85",
    "text-muted": "ink.muted",
    "text-inverse": "paper",
    "line-hairline": "ink.12",
    "line-border": "ink.20",
    "line-strong": "ink.64",
    "fill-subtle": "ink.6",
    "fill-emphasis": "ink.12",
    "fill-inverse": "ink.100",
    "fill-inverse-hover": "ink.85",
    "fill-bar": "ink.64",
    "surface-base": "paper",
    "surface-glass": "paper@0.84",
    "surface-scrim": "shade@0.42",
    "focus-ring": "ink.100",
    "danger-text": "exception.danger",
    "danger-wash": "exception.danger~6",
    "warn-text": "exception.warn",
    "warn-wash": "exception.warn~6"
  },
  "exceptionJustification": "Danger and warn are the only hues. They carry meaning that must survive a quick glance: an irreversible or blocked action (danger: validation, 409, injection) and a caution about the provenance of what you are reading (warn: Simulated mode, offline). Each always ships with an icon and a word, so colour is never the only signal.",
  "contrast": {
    "text": 7.0,
    "nonText": 3.0,
    "checks": [
      [
        "text-primary",
        [
          "surface-base",
          "fill-subtle",
          "fill-emphasis"
        ]
      ],
      [
        "text-secondary",
        [
          "surface-base",
          "fill-subtle"
        ]
      ],
      [
        "text-muted",
        [
          "surface-base",
          "fill-subtle"
        ]
      ],
      [
        "text-inverse",
        [
          "fill-inverse",
          "fill-inverse-hover"
        ]
      ],
      [
        "danger-text",
        [
          "surface-base",
          "danger-wash"
        ]
      ],
      [
        "warn-text",
        [
          "surface-base",
          "warn-wash"
        ]
      ]
    ],
    "nonTextChecks": [
      [
        "line-strong",
        [
          "surface-base",
          "fill-subtle"
        ]
      ],
      [
        "fill-bar",
        [
          "fill-emphasis",
          "surface-base"
        ]
      ],
      [
        "fill-inverse",
        [
          "fill-emphasis"
        ]
      ],
      [
        "focus-ring",
        [
          "surface-base",
          "fill-subtle"
        ]
      ],
      [
        "danger-text",
        [
          "danger-wash"
        ]
      ]
    ]
  },
  "type": {
    "families": {
      "serif": "\"Newsreader\", \"Source Serif Pro\", Georgia, serif",
      "sans": "\"Geist\", \"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "mono": "\"Geist Mono\", \"IBM Plex Mono\", ui-monospace, Menlo, monospace"
    },
    "roles": {
      "display": {
        "family": "serif",
        "size": 44,
        "line": 1.12,
        "weight": 450,
        "track": -0.02,
        "use": "The claim under review"
      },
      "headline": {
        "family": "sans",
        "size": 20,
        "line": 1.3,
        "weight": 600,
        "track": -0.01,
        "use": "Panel and dialog titles, empty-state title (serif variant via .t-headline.serif)"
      },
      "lead": {
        "family": "serif",
        "size": 21,
        "line": 1.55,
        "weight": 400,
        "track": 0,
        "use": "Question and evidence (content under review)"
      },
      "body": {
        "family": "sans",
        "size": 16,
        "line": 1.55,
        "weight": 400,
        "track": 0,
        "use": "Default UI text, option labels, buttons"
      },
      "small": {
        "family": "sans",
        "size": 14,
        "line": 1.5,
        "weight": 400,
        "track": 0,
        "use": "Form text, alerts, menu items, property values"
      },
      "caption": {
        "family": "sans",
        "size": 13,
        "line": 1.45,
        "weight": 400,
        "track": 0,
        "use": "Help lines, property labels, legends"
      },
      "kicker": {
        "family": "sans",
        "size": 12,
        "line": 1.3,
        "weight": 600,
        "track": 0.08,
        "case": "uppercase",
        "use": "Section eyebrows: QUESTION, CANDIDATE ANSWER"
      },
      "meta": {
        "family": "sans",
        "size": 13,
        "line": 1.4,
        "weight": 500,
        "track": 0,
        "numeric": "tabular-nums",
        "use": "Counts, percentages, latency"
      },
      "mono": {
        "family": "mono",
        "size": 13,
        "line": 1.4,
        "weight": 500,
        "track": 0,
        "use": "Task IDs, model names"
      }
    },
    "narrow": {
      "display": 30,
      "lead": 18
    }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80
  },
  "touch": 44,
  "radius": {
    "sm": "4px",
    "md": "12px",
    "sheet": "20px",
    "pill": "999px",
    "circle": "50%"
  },
  "border": "1px",
  "shadow": "0 16px 40px -12px shade@0.28, 0 2px 6px shade@0.08",
  "motion": {
    "fast": "0.2s",
    "base": "0.35s",
    "slow": "0.5s",
    "theme": "0.45s",
    "ease-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "ease-exit": "cubic-bezier(0.4, 0, 1, 1)",
    "stagger": "52ms"
  },
  "layers": {
    "base": 0,
    "raised": 1,
    "sticky": 10,
    "banner": 20,
    "scrim": 30,
    "dialog": 40,
    "popover": 50,
    "toast": 60
  },
  "layout": {
    "side": "240px",
    "rail": "408px",
    "topbar": "52px",
    "doc": "700px"
  }
}