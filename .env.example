# Local synthetic demo only. No hosted authentication or inference account needed.
# Export relevant values in each shell; the application does not auto-load this file.
APP_MODE=demo
VITE_APP_MODE=demo
LIVE_INFERENCE_ENABLED=false
DATABASE_URL=postgresql://localhost/reviewflow_dev
TRUSTED_ORIGINS=http://localhost:8080
LOG_LEVEL=info
# Generate your own random value. An explicit value is required in production.
SESSION_SECRET=replace-with-a-long-random-local-value
# Database-backed anonymous demo admission limits (global across API processes).
DEMO_PROJECT_CAP=100
DEMO_PROJECT_CREATION_WINDOW_MAX=10
DEMO_PROJECT_CREATION_WINDOW_SECONDS=60

# API, web, worker, and proxy ports are process-specific; see docs/setup.md.
PORT=5000
WORKER_PORT=5001
BASE_PATH=/
REVIEWFLOW_API_ORIGIN=http://127.0.0.1:5000
REVIEWFLOW_WEB_ORIGIN=http://127.0.0.1:5173

# Migration variables intentionally do not fall back to DATABASE_URL.
REVIEWFLOW_MIGRATION_DATABASE_URL=postgresql://localhost/reviewflow_dev
REVIEWFLOW_MIGRATION_CONFIRM=reviewflow_dev
REVIEWFLOW_DISPOSABLE_DB=1

# Optional advanced mode only; leave blank in demo and never commit real keys.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=
# Server-only provider credential; never create a VITE_ equivalent.
TYPESAFE_API_KEY=